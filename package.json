{
  "name": "deid-allowlist",
  "version": "2.0.0",
  "description": "Drops every field you did not explicitly allow, before a record leaves your machine",
  "type": "module",
  "main": "./dist/deid.js",
  "types": "./dist/deid.d.ts",
  "exports": {
    ".": {
      "types": "./dist/deid.d.ts",
      "import": "./dist/deid.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "author": "Justin Rhee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justin-rhee/deid-allowlist.git"
  },
  "homepage": "https://github.com/justin-rhee/deid-allowlist#readme",
  "bugs": "https://github.com/justin-rhee/deid-allowlist/issues",
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0"
  }
}
